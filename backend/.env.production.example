# NovaMind AI Backend - Production Environment Variables
# Copy to /opt/novamind/.env on the server, then `chmod 600`.

# --- REQUIRED ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-me-with-secrets-token-urlsafe-64
# MUST be unset (or 0) in production. Setting this bypasses the
# placeholder-SECRET_KEY boot guard, which is unsafe in prod.
ALLOW_DEV_SECRET_KEY=0

# SQLite database file (lives in /opt/novamind/novamind.db on the VM).
# To use Postgres instead: DATABASE_URL=postgresql://user:pass@localhost:5432/novamind
DATABASE_URL=sqlite:///./novamind.db

# --- OPTIONAL (have safe defaults) ---
# Allow Vercel frontend + your local browser.
BACKEND_CORS_ORIGINS=https://novamind-ai-kappa.vercel.app,http://localhost:3000
# Allow any *.vercel.app preview URL. Leave off in production.
ALLOW_VERCEL_PREVIEWS=0

# Google OAuth — leave blank to disable social login (email/password still works).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Redis / ChromaDB — left unset means the in-memory shim is used (fine for free tier).
# REDIS_URL=redis://localhost:6379
# CHROMA_HOST=localhost
# CHROMA_PORT=8000

# --- Ollama (if running the LLM on this server) ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_TIMEOUT_S=55

# --- SMTP (email verification + password reset) ---
# Empty SMTP_HOST falls back to a dev stub that writes sent messages
# to logs/dev-mail.log — fine for dev / CI, NOT fine in production.
#
# === Gmail (recommended for solo developers, free) ===
# 1. Go to https://myaccount.google.com/security
# 2. Enable "2-Step Verification" (required to mint an app password).
# 3. Open "App passwords" (https://myaccount.google.com/apppasswords).
# 4. Create one for "Mail / Other (NovaMind)". Google shows a 16-char
#    password — copy it once, it won't be shown again.
# 5. Set the two GMAIL_* values below. SMTP_HOST defaults to
#    smtp.gmail.com with STARTTLS on 587 — leave it alone unless your
#    Google account uses a custom relay.
#
# GMAIL_ADDRESS=you@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
#
# === Other relays (SendGrid, Mailgun, SES, Postmark, custom SMTP) ===
# Override SMTP_HOST and use SMTP_USERNAME / SMTP_PASSWORD directly.
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=SG.your-sendgrid-key
# SMTP_TLS=1
# SMTP_FROM=noreply@yourdomain.com
# SMTP_FROM_NAME=NovaMind

# --- Frontend base URL (where email links point) ---
# This MUST match your deployed Vercel URL so verification / reset
# links land on the real app, not localhost.
FRONTEND_BASE_URL=https://novamind-ai-kappa.vercel.app

# --- Default AI model ---
DEFAULT_MODEL=llama3.2:3b

# --- Stripe (billing) ---
# Leave STRIPE_SECRET_KEY empty to run in MOCK MODE: /pricing works,
# "Subscribe" opens a dialog saying Stripe is not configured, no real
# charges happen. Set the four values below to switch to live Stripe.
#
# 1. Create a Stripe account (https://dashboard.stripe.com/register).
# 2. Switch to Test mode (top-right toggle) and grab a test secret key
#    from https://dashboard.stripe.com/test/apikeys.
# 3. Create two recurring products (Pro and Business) at
#    https://dashboard.stripe.com/test/products and copy each price ID
#    (price_...).
# 4. For webhooks, install the Stripe CLI and run:
#       stripe listen --forward-to https://<your-tunnel>/api/v1/billing/webhook
#    The CLI prints a `whsec_...` signing secret — paste it below.
#
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_BUSINESS=price_...
# PUBLIC_SITE_URL=https://novamind-ai-kappa.vercel.app