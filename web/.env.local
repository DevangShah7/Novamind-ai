# NovaMind AI Frontend Environment Variables
# Copy this file to .env.local and fill in the values

# Backend URL — public Cloudflare-tunnel front for the FastAPI service
# running on the same machine as Ollama. The frontend only ever talks
# to this URL; Ollama is private on localhost:11434.
NEXT_PUBLIC_API_URL=https://efficiently-vital-handed-habits.trycloudflare.com/api/v1

# Set to 'false' so the frontend talks to the real backend, not the
# in-browser localStorage mock.
NEXT_PUBLIC_USE_MOCK=false
